# Required: local Zotero sqlite database
ZOTERO_SQLITE_PATH=

# Required: Zotero attachment storage root
ZOTERO_STORAGE_DIR=

# Persistent cache root for extracted PDF text and AI analysis summaries
ZOTERO_CACHE_DIR=

# Optional: Default output directory for generated manual export files
ZOTERO_OUTPUT_DIR=output

# Optional: Snapshot backups directory (defaults to $ZOTERO_CACHE_DIR/backups)
# ZOTERO_BACKUP_DIR=

# Optional: Mutation backend mode: auto | local | remote
# auto: Default (prefers local desktop client, falls back to remote cloud API)
# local: Forces local Zotero 7/10 desktop API on port 23119
# remote: Forces official Zotero Web API (https://api.zotero.org)
ZOTERO_MUTATION_BACKEND=auto

# Optional: Local and Remote API endpoints
ZOTERO_LOCAL_API_URL=http://127.0.0.1:23119/api
ZOTERO_REMOTE_API_URL=https://api.zotero.org

# Note: Sensitive credentials (ZOTERO_USER_ID, ZOTERO_API_KEY, ZOTERO_LOCAL_API_KEY)
# are recommended to be placed in User Environment Variables rather than committed .env files.
